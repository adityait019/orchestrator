        <mxCell id="s2" value="2. FastAPI routes request&#xa;main.py + routers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1">
