  <diagram id="a2a-hitl-lifecycle" name="A2A HITL Lifecycle">
    <mxGraphModel dx="1990" dy="837" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ltitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=26;" value="A2A Request Lifecycle - HITL, Input Required, Continuation" vertex="1">
          <mxGeometry height="50" width="1200" x="300" y="30" as="geometry" />
        </mxCell>
        <mxCell id="l1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" value="1. User prompt&lt;br&gt;&lt;br&gt;WebSocket sends prompt and optional uploaded file references." vertex="1">
          <mxGeometry height="120" width="260" x="75" y="140" as="geometry" />
        </mxCell>
        <mxCell id="l2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;" value="2. Nexus plans&lt;br&gt;&lt;br&gt;Uses dynamic sub-agent metadata from registered agent cards." vertex="1">
          <mxGeometry height="120" width="280" x="450" y="140" as="geometry" />
        </mxCell>
        <mxCell id="l3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" value="3. HITL approval&lt;br&gt;&lt;br&gt;after_model_callback intercepts transfer_to_agent and stores pending_transfer." vertex="1">
          <mxGeometry height="130" width="310" x="860" y="140" as="geometry" />
        </mxCell>
        <mxCell id="l4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" value="4. Approved transfer&lt;br&gt;&lt;br&gt;before_model_callback creates transfer_to_agent with _remote_message." vertex="1">
          <mxGeometry height="130" width="320" x="1300" y="140" as="geometry" />
        </mxCell>
        <mxCell id="l5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" value="5. RemoteServerManager&lt;br&gt;&lt;br&gt;Reads _remote_message and any existing task_id/context_id." vertex="1">
          <mxGeometry height="130" width="320" x="1300" y="385" as="geometry" />
        </mxCell>
        <mxCell id="l6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" value="6. A2A adapter sends message&lt;br&gt;&lt;br&gt;First call: no task_id/context_id.&lt;br&gt;Continuation: reuse both ids." vertex="1">
          <mxGeometry height="140" width="320" x="875" y="385" as="geometry" />
        </mxCell>
        <mxCell id="l7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;" value="7. Remote A2A agent&lt;br&gt;&lt;br&gt;Streams tool events, text, files, token usage, and A2A state." vertex="1">
          <mxGeometry height="140" width="310" x="455" y="385" as="geometry" />
        </mxCell>
        <mxCell id="l8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" value="8. EventProcessor&lt;br&gt;&lt;br&gt;Normalizes events, emits WebSocket updates, stores artifacts, updates invocation trace." vertex="1">
          <mxGeometry height="150" width="300" x="75" y="385" as="geometry" />
        </mxCell>
        <mxCell id="l9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;" value="9. input-required&lt;br&gt;&lt;br&gt;Store orchestrator.task with owner, state, task_id, context_id, interaction=request_input." vertex="1">
          <mxGeometry height="155" width="350" x="75" y="660" as="geometry" />
        </mxCell>
        <mxCell id="l10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" value="10. User follow-up&lt;br&gt;&lt;br&gt;Example: proceed with final summary; do not include RAG." vertex="1">
          <mxGeometry height="135" width="310" x="540" y="670" as="geometry" />
        </mxCell>
        <mxCell id="l11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" value="11. Continuation transfer&lt;br&gt;&lt;br&gt;Route to owner with same task_id/context_id and latest _remote_message." vertex="1">
          <mxGeometry height="145" width="350" x="945" y="660" as="geometry" />
        </mxCell>
        <mxCell id="l12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" value="12. Terminal state&lt;br&gt;&lt;br&gt;completed/failed/canceled clears orchestrator.task and completes invocation/workflow." vertex="1">
